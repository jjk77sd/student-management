<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thi Đua Học Tập - Quản Lý Sinh Viên</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <!-- Sidebar -->
<nav class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse text-white min-vh-100 p-3 d-flex flex-column justify-content-between">
    <div>
        <!-- Tiêu đề Sidebar -->
        <h4 class="text-center py-3 text-info border-bottom border-secondary">
            <i class="bi bi-mortarboard-fill"></i> QL Sinh Viên
        </h4>
        
        <!-- Danh sách Menu -->
        <ul class="nav flex-column mt-3">
            <li class="nav-item mb-2">
                <a href="/" class="nav-link text-white">
                    <i class="bi bi-house-door me-2"></i> Trang chủ
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/students" class="nav-link text-white">
                    <i class="bi bi-people me-2"></i> Sinh viên
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/emulation" class="nav-link text-white">
                    <i class="bi bi-award me-2"></i> Thi đua học tập
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/classes" class="nav-link text-white">
                    <i class="bi bi-building me-2"></i> Lớp
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/majors" class="nav-link text-white">
                    <i class="bi bi-book me-2"></i> Ngành
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/timetable" class="nav-link text-white">
                    <i class="bi bi-calendar-week me-2"></i> Thời khóa biểu
                </a>
            </li>
        </ul>
    </div>

    <!-- Ô Quản Trị Viên ở góc dưới cùng -->
    <div class="border-top border-secondary pt-3 mt-auto">
        <div class="d-flex align-items-center justify-content-between text-white px-2">
            <div>
                <h6 class="mb-0 fw-bold" style="font-size: 0.95rem;">Quản trị viên</h6>
                <small class="text-muted" style="font-size: 0.8rem;">admin@student.vn</small>
            </div>
            <a href="/logout" class="text-white text-decoration-none" title="Đăng xuất">
    <i class="bi bi-box-arrow-right fs-5"></i>
</a>
        </div>
    </div>
</nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2 text-primary">Quản Lý Thi Đua Học Tập</h1>
                    <span class="text-muted"><i class="bi bi-person-circle"></i> Xin chào, Admin</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Bảng tổng hợp điểm số & thi đua</h3>
                    <a href="/emulation/add" class="btn btn-success shadow-sm"><i class="bi bi-plus-lg"></i> Thêm đánh giá thi đua</a>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Mã SV</th>
                                    <th>Họ và Tên</th>
                                    <th>Điểm GPA</th>
                                    <th>Điểm Rèn Luyện</th>
                                    <th>Xếp Loại</th>
                                    <th class="text-center">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (emulations && emulations.length > 0) { %>
                                    <% emulations.forEach(item => { %>
                                        <tr>
                                            <td><%= item.id %></td>
                                            <td><strong><%= item.student_code %></strong></td>
                                            <td><%= item.full_name %></td>
                                            <td><span class="badge bg-info text-dark"><%= item.gpa %></span></td>
                                            <td><span class="badge bg-secondary"><%= item.conduct_score %></span></td>
                                            <td>
                                                <% if (item.classification === 'Xuất sắc') { %>
                                                    <span class="badge bg-success">Xuất sắc</span>
                                                <% } else if (item.classification === 'Giỏi') { %>
                                                    <span class="badge bg-primary">Giỏi</span>
                                                <% } else if (item.classification === 'Khá') { %>
                                                    <span class="badge bg-warning text-dark">Khá</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Trung bình</span>
                                                <% } %>
                                            </td>
                                            <td class="text-center">
                                                <form action="/emulation/delete/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bản ghi này?');">
                                                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Xóa</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">Chưa có dữ liệu thi đua nào.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>