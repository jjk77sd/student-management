<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thêm Ngành Mới</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="text-center mb-4 text-success">Thêm Ngành Đào Tạo Mới</h2>
                
                <form action="/majors/add" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Mã Ngành:</label>
                        <input type="text" name="major_code" class="form-control" required placeholder="Ví dụ: IT">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Tên Ngành:</label>
                        <input type="text" name="major_name" class="form-control" required placeholder="Ví dụ: Công nghệ thông tin">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Mô tả:</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Nhập mô tả ngắn về ngành..."></textarea>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="/majors" class="btn btn-secondary">Quay lại</a>
                        <button type="submit" class="btn btn-success">Lưu ngành</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>