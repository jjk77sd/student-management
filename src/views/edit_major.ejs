<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chỉnh Sửa Ngành Học</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="text-center mb-4 text-warning">Chỉnh Sửa Thông Tin Ngành Học</h2>
                
                <form action="/majors/edit/<%= majorItem.id %>" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Mã Ngành:</label>
                        <input type="text" name="major_code" class="form-control" value="<%= majorItem.major_code %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Tên Ngành:</label>
                        <input type="text" name="major_name" class="form-control" value="<%= majorItem.major_name %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Mô Tả:</label>
                        <textarea name="description" class="form-control" rows="3"><%= majorItem.description %></textarea>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="/majors" class="btn btn-secondary">Quay lại</a>
                        <button type="submit" class="btn btn-warning text-white">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>