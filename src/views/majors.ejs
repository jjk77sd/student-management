<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Ngành Học</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse text-white min-vh-100 p-3">
                <div class="position-sticky">
                    <h4 class="text-center py-3 text-info border-bottom border-secondary">
                        <i class="bi bi-mortarboard-fill"></i> QL Sinh Viên
                    </h4>
                    <ul class="nav flex-column mt-3">
                        <li class="nav-item mb-2">
                            <a href="/" class="nav-link text-white">
                                <i class="bi bi-house-door me-2"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a href="/students" class="nav-link text-white">
                                <i class="bi bi-people me-2"></i> Sinh viên
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a href="/emulation" class="nav-link text-white">
                                <i class="bi bi-award me-2"></i> Thi đua học tập
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a href="/classes" class="nav-link text-white">
                                <i class="bi bi-building me-2"></i> Lớp
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a href="/majors" class="nav-link text-white active bg-primary rounded">
                                <i class="bi bi-book me-2"></i> Ngành
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2 text-primary">Quản Lý Ngành Học</h1>
                    <span class="text-muted"><i class="bi bi-person-circle"></i> Xin chào, Admin</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Danh sách các ngành đào tạo</h3>
                    <a href="/majors/add" class="btn btn-success shadow-sm"><i class="bi bi-plus-lg"></i> Thêm ngành mới</a>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Mã Ngành</th>
                                    <th>Tên Ngành Đào Tạo</th>
                                    <th>Mô tả</th>
                                    <th class="text-center">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (majors && majors.length > 0) { %>
                                    <% majors.forEach(major => { %>
                                        <tr>
                                            <td><%= major.id %></td>
                                            <td><strong><%= major.major_code %></strong></td>
                                            <td><%= major.major_name %></td>
                                            <td><%= major.description %></td>
                                            <td class="text-center">
                                                <form action="/majors/delete/<%= major.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa ngành này?');">
                                                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Xóa</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">Chưa có dữ liệu ngành học nào.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>