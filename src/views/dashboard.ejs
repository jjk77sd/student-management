<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Chủ - Quản Lý Sinh Viên</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Nhúng thư viện Chart.js để vẽ biểu đồ -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-light">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <!-- Sidebar -->
<nav class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse text-white min-vh-100 p-3 d-flex flex-column justify-content-between">
    <div>
        <!-- Tiêu đề Sidebar -->
        <h4 class="text-center py-3 text-info border-bottom border-secondary">
            <i class="bi bi-mortarboard-fill"></i> QL Sinh Viên
        </h4>
        
        <!-- Danh sách Menu -->
        <ul class="nav flex-column mt-3">
            <li class="nav-item mb-2">
                <a href="/" class="nav-link text-white">
                    <i class="bi bi-house-door me-2"></i> Trang chủ
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/students" class="nav-link text-white">
                    <i class="bi bi-people me-2"></i> Sinh viên
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/emulation" class="nav-link text-white">
                    <i class="bi bi-award me-2"></i> Thi đua học tập
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/classes" class="nav-link text-white">
                    <i class="bi bi-building me-2"></i> Lớp
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/majors" class="nav-link text-white">
                    <i class="bi bi-book me-2"></i> Ngành
                </a>
            </li>
            <li class="nav-item mb-2">
                <a href="/timetable" class="nav-link text-white">
                    <i class="bi bi-calendar-week me-2"></i> Thời khóa biểu
                </a>
            </li>
        </ul>
    </div>

    <!-- Ô Quản Trị Viên ở góc dưới cùng -->
    <div class="border-top border-secondary pt-3 mt-auto">
        <div class="d-flex align-items-center justify-content-between text-white px-2">
            <div>
                <h6 class="mb-0 fw-bold" style="font-size: 0.95rem;">Quản trị viên</h6>
                <small class="text-muted" style="font-size: 0.8rem;">admin@student.vn</small>
            </div>
            <a href="/logout" class="text-white text-decoration-none" title="Đăng xuất">
    <i class="bi bi-box-arrow-right fs-5"></i>
</a>
        </div>
    </div>
</nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2 text-primary">Tổng Quan Hệ Thống</h1>
                    <span class="text-muted"><i class="bi bi-person-circle"></i> Xin chào, Admin</span>
                </div>

                <!-- Các Thẻ Thống Kê (Cards) -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card text-white bg-success shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-people-fill"></i> Tổng số sinh viên</h5>
                                <h3><%= totalStudents %></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-white bg-primary shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-building"></i> Tổng số lớp</h5>
                                <h3><%= totalClasses %></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-white bg-info shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-book"></i> Ngành đào tạo</h5>
                                <h3><%= totalMajors %></h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Khu vực hiển thị Biểu đồ thống kê -->
                <div class="row">
                    <div class="col-md-8 mb-4">
                        <div class="card shadow-sm p-3">
                            <h5 class="card-title text-secondary mb-3"><i class="bi bi-bar-chart-fill"></i> Thống kê số lượng sinh viên theo Ngành</h5>
                            <div style="position: relative; height: 300px; width: 100%;">
                                <canvas id="studentMajorChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm p-4 text-center h-100 d-flex flex-column justify-content-center">
                            <h4 class="text-primary mb-3">Chào mừng trở lại!</h4>
                            <p class="text-muted">Hệ thống quản lý sinh viên giúp bạn dễ dàng theo dõi dữ liệu học tập, lớp học và thi đua một cách trực quan nhất.</p>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Script cấu hình vẽ biểu đồ bằng Chart.js (Đã tối ưu hiển thị chữ và bo góc cột) -->
    <script>
        const majorData = JSON.parse('<%- JSON.stringify(majorStats || []) %>');

        const labels = majorData.map(item => item.major || 'Chưa phân ngành');
        const dataCounts = majorData.map(item => item.count);

        const ctx = document.getElementById('studentMajorChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Số lượng sinh viên',
                    data: dataCounts,
                    backgroundColor: [
                        'rgba(13, 110, 253, 0.75)',
                        'rgba(25, 135, 84, 0.75)',
                        'rgba(255, 193, 7, 0.75)',
                        'rgba(220, 53, 69, 0.75)',
                        'rgba(111, 66, 193, 0.75)',
                        'rgba(13, 202, 240, 0.75)'
                    ],
                    borderColor: [
                        'rgb(13, 110, 253)',
                        'rgb(25, 135, 84)',
                        'rgb(255, 193, 7)',
                        'rgb(220, 53, 69)',
                        'rgb(111, 66, 193)',
                        'rgb(13, 202, 240)'
                    ],
                    borderWidth: 1.5,
                    borderRadius: 6 // Bo tròn đầu cột cực kỳ hiện đại
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            font: {
                                size: 11,
                                weight: '500'
                            },
                            maxRotation: 20,
                            minRotation: 0,
                            callback: function(value, index, ticks) {
                                // Tự động cắt ngắn tên ngành quá dài để không bị tràn chữ
                                let label = this.getLabelForValue(value);
                                if (label.length > 16) {
                                    return label.substring(0, 14) + '...';
                                }
                                return label;
                            }
                        },
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        },
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    }
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>