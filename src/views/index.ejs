<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Sinh Viên</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container-fluid">
        <div class="row">
            <!-- SIDEBAR (Menu bên trái) -->
            <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse text-white min-vh-100 p-3">
                <div class="position-sticky">
                    <h4 class="text-center py-3 text-info border-bottom border-secondary">
                        <i class="bi bi-mortarboard-fill"></i> QL Sinh Viên
                    </h4>
                    <ul class="nav flex-column mt-3">
                        <li class="nav-item mb-2">
                            <a href="/" class="nav-link text-white active bg-primary rounded">
                                <i class="bi bi-house-door me-2"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a href="/" class="nav-link text-white hover-bg">
                                <i class="bi bi-people me-2"></i> Sinh viên
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a href="#" class="nav-link text-white hover-bg" onclick="alert('Tính năng Lớp đang phát triển!'); return false;">
                                <i class="bi bi-building me-2"></i> Lớp
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a href="#" class="nav-link text-white hover-bg" onclick="alert('Tính năng Ngành đang phát triển!'); return false;">
                                <i class="bi bi-book me-2"></i> Ngành
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- MAIN CONTENT (Nội dung bên phải) -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <!-- Thanh Header nhỏ phía trên -->
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2 text-primary">Quản Lý Sinh Viên</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <span class="text-muted me-3 mt-2"><i class="bi bi-person-circle"></i> Xin chào, Admin</span>
                    </div>
                </div>

                <!-- Khu vực Thống kê nhanh (Tùy chọn cho đẹp) -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card text-white bg-success shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-people-fill"></i> Tổng số sinh viên</h5>
                                <h3><%= students ? students.length : 0 %></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card text-white bg-info shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-mortarboard"></i> Hệ đào tạo</h5>
                                <h3>Chính quy</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bảng danh sách sinh viên -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Danh sách sinh viên</h3>
                    <a href="/add" class="btn btn-success shadow-sm"><i class="bi bi-plus-lg"></i> Thêm sinh viên mới</a>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Mã Sinh Viên</th>
                                    <th>Họ và Tên</th>
                                    <th>Email</th>
                                    <th>Chuyên Ngành</th>
                                    <th class="text-center">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (students && students.length > 0) { %>
                                    <% students.forEach(student => { %>
                                        <tr>
                                            <td><%= student.id %></td>
                                            <td><strong><%= student.student_code %></strong></td>
                                            <td><%= student.full_name %></td>
                                            <td><%= student.email %></td>
                                            <td><%= student.major %></td>
                                            <td class="text-center">
                                                <a href="/edit/<%= student.id %>" class="btn btn-warning btn-sm me-1 text-white">
                                                    <i class="bi bi-pencil-square"></i> Sửa
                                                </a>
                                                <form action="/delete/<%= student.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sinh viên này không?');">
                                                    <button type="submit" class="btn btn-danger btn-sm">
                                                        <i class="bi bi-trash"></i> Xóa
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">Chưa có dữ liệu sinh viên nào.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>